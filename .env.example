# PromptForge — copy to .env and fill in

# Backend
PORT=4400
NODE_ENV=development
LOG_LEVEL=info

# Postgres (docker-compose default matches)
DATABASE_URL=postgres://promptforge:promptforge@localhost:5434/promptforge

# Master admin API key — created on first boot if none exists. Overrideable.
# Format: pf_<32-char-random>. Generate with: openssl rand -hex 24 | awk '{print "pf_"$1}'
ADMIN_API_KEY=pf_change_me_in_production_0000000000000000

# CORS (frontend)
CORS_ORIGIN=http://localhost:4300

# LLM providers (add at least one for evals to work)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cost caps — hard 429 when hit
DAILY_SPEND_CAP_USD=5
MONTHLY_SPEND_CAP_USD=50

# Web
NEXT_PUBLIC_API_BASE=http://localhost:4400/api
